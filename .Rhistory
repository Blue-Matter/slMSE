library(miceadds)
library(openMSE)
library(abind)
library(mahiMSE)
packageVersion('MSEtool')
setwd("C:/Github/DolphinMSE")
source.all("code/Source")
ref_grid = readRDS('OMs/ref_grid.rds')
OMno = 29
load("OMs/Reference_set/OM_29.RData")
refOM = OM_29
yts = refOM@nYear
pts = refOM@pYear             # just projected time steps
nts = yts+pts # all time steps
nsim = refOM@nSim
nr = dim(refOM@Stock[[1]]@Spatial@Movement)[3]
nf = nFleet(refOM)
nage = as.numeric(nAge(refOM))
stockno = 1
outdir = "C:/Github/DolphinMSE/OMs/Robustness_set"
# -
ROM_C1 = refOM
# Note, might have to be by sim
C_pc = 1; fleetno = 8  # Fleets
vec = c(rep(1,yts),(1+C_pc/100)^(1:pts))
ROM_C1@Imp[[stockno]][[fleetno]]@TAC@Mean = array(rep(vec,each=nsim),c(1,nts))
vec = c(rep(1,yts),(1-C_pc/100)^(1:pts))
ROM_C1@Obs[[stockno]][[fleetno]]@Landings@Error = array(rep(vec,each=nsim),c(nsim,nts))
object.size(ROM_C1)
ROM_C1@Name = paste0("ROM_C1: ",paste(ref_grid[OMno,],collapse="-"))
save(ROM_C1,file=paste0(outdir,"/ROM_C1.RData"))
# test = Simulate(ROM_C1, DoRefLandings = F)
# check refOM@Imp$Dolphinfish[[8]]@TAC@Mean[1,80] * refOM@Obs$Dolphinfish[[8]]@Landings@Bias[1,80]
ROM_R1 = refOM
R_pc = 1
RDP = refOM@Stock[[stockno]]@SRR@RecDevProj
vec = (1-R_pc/100)^(1:pts)
RDP = RDP * array(rep(vec,each=nsim),c(nsim,pts))
ROM_R1@Stock[[stockno]]@SRR@RecDevProj = RDP
ROM_R1@Name = paste0("ROM_R1: ",paste(ref_grid[OMno,],collapse="-"))
save(ROM_R1,file=paste0(outdir,"/ROM_R1.RData"))
#  test = Simulate(ROM_R1, DoRefLandings = F))
ROM_R2 = refOM
red = 0.25; ny = 5
RDP = refOM@Stock[[stockno]]@SRR@RecDevProj
vec = c(rep(1-red,ny*4),rep(1,pts-ny*4))
RDP = RDP * array(rep(vec,each=nsim),c(nsim,pts))
ROM_R2@Stock[[stockno]]@SRR@RecDevProj = RDP
ROM_R2@Name = paste0("ROM_R2: ",paste(ref_grid[OMno,],collapse="-"))
