ROM_R4 = refOM
RDP = refOM@Stock[[stockno]]@SRR@RecDevProj
optint = function(par,RDP,targ=1.5){(sd(exp(log(RDP)*exp(par)))/sd(RDP) - targ)^2} # what is the correct log adjustment to add 50% more sd
opt = optimize(optint,log(c(1,3)),RDP=RDP)
fac = exp(opt$minimum)
ROM_R4@Stock[[stockno]]@SRR@RecDevProj = exp(log(RDP)*fac)
ROM_R4@Name = paste0("ROM_R4: ",paste(ref_grid[OMno,],collapse="-"))
save(ROM_R4,file=paste0(outdir,"/ROM_R4.RData"))
# S1 2% decline in CAR - SFL, 1 % increase in SE, 3% increase in NC and NE
ROM_S1 = refOM
mov = refOM@Stock[[stockno]]@Spatial@Movement
# Get the current distribution inferred by movement
disty = getdist(mov)
# Apply change in distribution (distiribution shift)
distmod = array(1,c(nts,nr))
pind = yts + 1:pts
distmod[pind,1] = (1-0.02/4)^(1:pts) # -2% per year
distmod[pind,3] = (1+0.01/4)^(1:pts) # 1% per year
distmod[pind,5] = (1+0.03/4)^(1:pts) # 3% per year
newdist = disty
dind = MSEtool:::TEG(dim(disty))
newdist[dind] = disty[dind] * distmod[dind[,2:3]]
allmov = solvemov(newdist)   # Solves move for each simulation
ROM_S1@Stock[[stockno]]@Spatial@Movement = mapmov(ROM_S1, allmov, nr, nts, pind) # Map new movement to projected time period
# test = Simulate(ROM_S1, DoRefLandings = F))
ROM_S1@Name = paste0("ROM_S1: ",paste(ref_grid[OMno,],collapse="-"))
save(ROM_S1,file=paste0(outdir,"/ROM_S1.RData"))
ROM_S2 = refOM
mov = refOM@Stock[[stockno]]@Spatial@Movement
# Get the current distribution inferred by movement
disty = getdist(mov)          # calculate the distribution inferred by the movement matrix
newdist = exp(log(disty)*1.5) # log space increase of 50%
newdist = newdist/array(apply(newdist,1:2,sum),dim(newdist)) # standardise back to sum 1 over areas
allmov = solvemov(newdist)   # Solves move for each simulation
ROM_S2@Stock[[1]]@Spatial@Movement = mapmov(ROM_S2, allmov, nr, nts, pind) # Map new movement to projected time period
ROM_S2@Name = paste0("ROM_S2: ",paste(ref_grid[OMno,],collapse="-"))
save(ROM_S2,file=paste0(outdir,"/ROM_S2.RData"))
