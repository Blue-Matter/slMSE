OM2Length
MSEtool:::OM2Length
# P1 1% pa decrease in somatic growth
ROM_P1 = refOM
Len = refOM@Stock[[stockno]]@Length
newlen = Len@MeanAtAge
lenfit = function(pars,obslen,plot=F){ # pars = log(c(1,0.25,1300))
t0=exp(pars[1]); k = exp(pars[2]); Linf = exp(pars[3])
agev = 0.5 + (1:length(obslen)) -1
predlen = Linf * (1-exp(-k*(agev+t0)))
if(plot){plot(obslen);lines(predlen,col="red")}
sum(abs(obslen-predlen))
}
pind = yts+1:pts
incvec = (1-0.01/4)^(1:pts)
ind = MSEtool:::TEG(c(nage,pts))
agevec = (1:as.integer(nage))-0.5
for(ss in 1:nsim){ # find growth pars per simulation
obslen = Len@MeanAtAge[ss,,yts]
opt = optim(log(c(1,0.25,1300)),lenfit,obslen=obslen)
lenfit(opt$par,obslen,plot=T)
t0 = -exp(opt$par[1])
k = exp(opt$par[2])
Linf = exp(opt$par[3])
Kvec = k * incvec
Lenyr = array(NA,c(nage,pts))
Lenyr[ind] = Linf * (1-exp(-Kvec[ind[,2]]*(agevec[ind[,1]]-t0)))
newlen[ss,,pind] = Lenyr
}
ROM_P1@Stock[[stockno]]@Length@MeanAtAge = newlen
ROM_P1@Name = paste0("ROM_P1: ",paste(ref_grid[OMno,],collapse="-"))
save(ROM_P1,file=paste0(outdir,"/ROM_P1.RData"))
# --- P2 -----------------------------------------------------------------------
# P2 1% decrease in condition factor
ROM_P2 = refOM
Len = refOM@Stock[[stockno]]@Length
Wt =  refOM@Stock[[stockno]]@Weight
newWt = Wt@MeanAtAge
WLfit = function(pars,obslen,obswt,plot=F){ # pars = log(c(1,0.25,1300))
a=exp(pars[1]); b = exp(pars[2])
predwt = a*obslen^b
if(plot){plot(obslen,obswt);lines(obslen,predwt,col="red")}
sum(abs(obswt-predwt))
}
pind = yts+1:pts
incvec = (1-0.01/4)^(1:pts)
ind = MSEtool:::TEG(c(nage,pts))
for(ss in 1:nsim){ # find growth pars per simulation
obslen = Len@MeanAtAge[ss,,yts]
obswt = Wt@MeanAtAge[ss,,yts]
opt = optim(log(c(0.0000001,3)),WLfit,obslen=obslen, obswt=obswt)
WLfit(opt$par,obslen,obswt,plot=T)
a = exp(opt$par[1])
b = exp(opt$par[2])
Wtyr = array(NA,c(nage,pts))
#adjb = log((obswt[ind[,1]]/a),obslen[ind[,1]]*incvec[ind[,2]])
Wtyr[ind] = (a*incvec[ind[,2]])*obslen[ind[,1]] ^ b
newWt[ss,,pind] = Wtyr
}
# plot(newWt[1,12,])
ROM_P2@Stock[[stockno]]@Weight@MeanAtAge = newWt
ROM_P2@Name = paste0("ROM_P2: ",paste(ref_grid[OMno,],collapse="-"))
save(ROM_P2,file=paste0(outdir,"/ROM_P2.RData"))
